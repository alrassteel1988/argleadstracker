# Server-only AI provider configuration. Never expose these keys in app.js or index.html.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
SUPABASE_LEAD_INTELLIGENCE_BUCKET=lead-intelligence-reports
# Create the administrator once, then remove ADMIN_BOOTSTRAP_PASSWORD from .env.
ADMIN_EMAIL=glory@alrassteel.com
ADMIN_BOOTSTRAP_PASSWORD=
APP_SESSION_SECRET=

# Shared abuse protection. RATE_LIMIT_HASH_SECRET must be identical on every API instance.
# Generate at least 32 random bytes and never expose it to the browser.
RATE_LIMIT_HASH_SECRET=
RATE_LIMIT_TENANT_ID=arg-leads-tracker
# Optional policy overrides. Defaults are secure and suitable for normal CRM use.
RATE_LIMIT_LOGIN_IP_MAX=20
RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_IP_BLOCK_SECONDS=300
RATE_LIMIT_LOGIN_ACCOUNT_MAX=5
RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_ACCOUNT_BLOCK_SECONDS=900
RATE_LIMIT_AI_MAX=30
RATE_LIMIT_AI_WINDOW_SECONDS=60
RATE_LIMIT_AI_BLOCK_SECONDS=60
RATE_LIMIT_TRANSCRIPTION_MAX=10
RATE_LIMIT_TRANSCRIPTION_WINDOW_SECONDS=60
RATE_LIMIT_TRANSCRIPTION_BLOCK_SECONDS=60
RATE_LIMIT_EXPORT_MAX=20
RATE_LIMIT_EXPORT_WINDOW_SECONDS=600
RATE_LIMIT_EXPORT_BLOCK_SECONDS=300
RATE_LIMIT_UPLOAD_MAX=30
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=600
RATE_LIMIT_UPLOAD_BLOCK_SECONDS=300
RATE_LIMIT_SEARCH_MAX=60
RATE_LIMIT_SEARCH_WINDOW_SECONDS=60
RATE_LIMIT_SEARCH_BLOCK_SECONDS=60
RATE_LIMIT_REPORT_MAX=30
RATE_LIMIT_REPORT_WINDOW_SECONDS=600
RATE_LIMIT_REPORT_BLOCK_SECONDS=300

# Vercel Cron sends this value as an Authorization bearer credential.
# Generate at least 32 random bytes (for example: openssl rand -hex 32).
CRON_SECRET=

# Supabase backend. Keep SUPABASE_SERVICE_ROLE_KEY server-side only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional private bucket override for Activity attachments.
SUPABASE_ACTIVITY_ATTACHMENTS_BUCKET=pmr-voice-notes

# Server-only lead discovery and enrichment keys.
GOOGLE_PLACES_API_KEY=
HUNTER_API_KEY=

# Phase 5 external integrations. Keep private keys server-side only.
REACT_APP_GOOGLE_PLACES_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
NEWS_API_KEY=
ERP_API_BASE_URL=
ERP_API_KEY=
ENABLE_GOOGLE_PLACES=true
ENABLE_CLAUDE_ENRICHMENT=true
ENABLE_MARKET_NEWS=true
ENABLE_ERP_LOOKUP=true
ENABLE_LINKEDIN_SEARCH=true
