{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "client.js", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "activity-modal.css", "use": "@vercel/static" },
    { "src": "activity-workflow.css", "use": "@vercel/static" },
    { "src": "ai-sales-assistant.css", "use": "@vercel/static" },
    { "src": "admin-dashboard-clean.css", "use": "@vercel/static" },
    { "src": "salesman-dashboard-live-leads.css", "use": "@vercel/static" },
    { "src": "lead-detail-readability.css", "use": "@vercel/static" },
    { "src": "lead-detail-contrast.css", "use": "@vercel/static" },
    { "src": "tasks-contrast.css", "use": "@vercel/static" },
    { "src": "activity-readability.css", "use": "@vercel/static" },
    { "src": "activity-dashboard-latest.css", "use": "@vercel/static" },
    { "src": "tasks-bauhaus-flat.css", "use": "@vercel/static" },
    { "src": "salesmen-directory.css", "use": "@vercel/static" },
    { "src": "salesman-dashboard-summaries.css", "use": "@vercel/static" },
    { "src": "pipeline-live-leads.css", "use": "@vercel/static" },
    { "src": "bauhaus-global.css", "use": "@vercel/static" },
    { "src": "sw.js", "use": "@vercel/static" },
    { "src": "favicon.svg", "use": "@vercel/static" },
    { "src": "manifest.json", "use": "@vercel/static" },
    { "src": "icons/icon-192.png", "use": "@vercel/static" },
    { "src": "icons/icon-512.png", "use": "@vercel/static" },
    { "src": "icons/icon-maskable-192.png", "use": "@vercel/static" },
    { "src": "icons/icon-maskable-512.png", "use": "@vercel/static" },
    { "src": "icons/shortcut-focus.png", "use": "@vercel/static" },
    { "src": "icons/shortcut-log.png", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "continue": true,
      "headers": {
        "Content-Security-Policy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; frame-src 'none'",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "DENY",
        "Permissions-Policy": "accelerometer=(), camera=(), geolocation=(self), gyroscope=(), magnetometer=(), microphone=(self), payment=(), usb=()"
      }
    },
    { "src": "/api/(.*)", "dest": "server.js" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/client.js", "dest": "/client.js" },
    { "src": "/styles.css", "dest": "/styles.css" },
    { "src": "/activity-modal.css", "dest": "/activity-modal.css" },
    { "src": "/activity-workflow.css", "dest": "/activity-workflow.css" },
    { "src": "/ai-sales-assistant.css", "dest": "/ai-sales-assistant.css" },
    { "src": "/admin-dashboard-clean.css", "dest": "/admin-dashboard-clean.css" },
    { "src": "/salesman-dashboard-live-leads.css", "dest": "/salesman-dashboard-live-leads.css" },
    { "src": "/lead-detail-readability.css", "dest": "/lead-detail-readability.css" },
    { "src": "/lead-detail-contrast.css", "dest": "/lead-detail-contrast.css" },
    { "src": "/tasks-contrast.css", "dest": "/tasks-contrast.css" },
    { "src": "/activity-readability.css", "dest": "/activity-readability.css" },
    { "src": "/activity-dashboard-latest.css", "dest": "/activity-dashboard-latest.css" },
    { "src": "/tasks-bauhaus-flat.css", "dest": "/tasks-bauhaus-flat.css" },
    { "src": "/salesmen-directory.css", "dest": "/salesmen-directory.css" },
    { "src": "/salesman-dashboard-summaries.css", "dest": "/salesman-dashboard-summaries.css" },
    { "src": "/pipeline-live-leads.css", "dest": "/pipeline-live-leads.css" },
    { "src": "/bauhaus-global.css", "dest": "/bauhaus-global.css" },
    { "src": "/sw.js", "dest": "/sw.js" },
    { "src": "/favicon.svg", "dest": "/favicon.svg" },
    { "src": "/manifest.json", "dest": "/manifest.json" },
    { "src": "/icons/icon-192.png", "dest": "/icons/icon-192.png" },
    { "src": "/icons/icon-512.png", "dest": "/icons/icon-512.png" },
    { "src": "/icons/icon-maskable-192.png", "dest": "/icons/icon-maskable-192.png" },
    { "src": "/icons/icon-maskable-512.png", "dest": "/icons/icon-maskable-512.png" },
    { "src": "/icons/shortcut-focus.png", "dest": "/icons/shortcut-focus.png" },
    { "src": "/icons/shortcut-log.png", "dest": "/icons/shortcut-log.png" },
    { "src": "/leads/([^/]+)/?", "dest": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/fetch-market-intelligence", "schedule": "0 2 * * 1" }
  ]
}
